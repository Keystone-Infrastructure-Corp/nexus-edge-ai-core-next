requires-core: 2
max-passes: 12
top-level-only: .agents/implement-loop.config .agents/implement-loop.unit-lines .agents/skills/implement-loop ui/src/api/types crates/nexus-cloud-protocol/src/v1.rs crates/nexus-cloud-protocol/src/v1.CHECKSUM Cargo.lock *package-lock.json
