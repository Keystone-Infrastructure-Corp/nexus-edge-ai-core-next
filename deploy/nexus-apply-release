#!/usr/bin/env bash
# nexus-apply-release — pinned, root-owned OTA release applier (the SINGLE
# privileged entrypoint of the OTA path).
#
# Installed by scripts/install.sh to /usr/local/sbin/nexus-apply-release
# (root:root 0755) — deliberately OUTSIDE the OTA-writable /opt/nexus tree so
# the unprivileged `nexus` service user cannot tamper with it. It is the ONLY
# command the `nexus-update` sudoers rule lets `nexus` run as root:
#
#   nexus ALL=(root) NOPASSWD: /usr/local/sbin/nexus-apply-release *
#
# WHY THIS EXISTS — the frozen privileged surface.
# ------------------------------------------------
# The OTA path used to whitelist the *exact argv* of four separate commands
# (`tar -xzf …`, `nexus-apply-deps …`, `ln -sfn …`, `systemctl --no-block
# restart …`) in /etc/sudoers.d/nexus-update. That coupled the sudoers file
# byte-for-byte to the engine's `std::process::Command` argv: any drift — a new
# flag, a reordered arg, an old sudoers file left on a box — made `sudo` refuse
# the command and BRICKED the OTA (an OTA cannot rewrite its own sudoers, which
# lives outside the nexus-writable tree). See the postmortem: an old sudoers
# line without `--no-block` rejected the restart and both the apply AND the
# rollback failed → `failed:rollback_also_failed`.
#
# This wrapper removes that whole class of failure: the sudoers grant is now a
# STABLE, argv-independent wildcard on ONE fixed path. The engine's privileged
# behaviour can evolve freely (this file is fixed, audited root code); the
# signed release supplies only DATA (which files exist, the apt list, the
# journald config), never new privileged behaviour or new argv. Adding a NEW
# kind of privileged action is a deliberate edit to THIS file, adopted via one
# install.sh/bootstrap run; thereafter it rides every OTA without ever touching
# sudoers again.
#
# MODES (arg1 is a fixed subcommand — the sudoers `*` matches it plus the
# version, but this script validates both strictly before doing anything):
#
#   apply  <version>   Full OTA apply. Extract the staged tarball
#                      (/opt/nexus/staging/update.tar.gz) into
#                      /opt/nexus/releases, verify releases/<version>/
#                      materialised, apply the release's privileged root-side
#                      bits (apt deps + journald cap, via nexus-apply-deps,
#                      WITHOUT pruning), flip /opt/nexus/current → the new
#                      release, and `systemctl --no-block restart
#                      nexus-engine`. Prune is deliberately NOT run here so the
#                      rollback target survives a failed apply.
#
#   reflip <version>   Rollback / re-point only. The release is already on disk
#                      and was Ed25519-verified at its original apply; flip
#                      `current` back to it and restart. No tarball, no deps.
#
#   prune  <version>   Reap stale release trees under /opt/nexus/releases,
#                      keeping ONLY the `current` target and <version>. Run by
#                      the NEW engine AFTER it has booted and passed its health
#                      check, so a rollback target is never deleted before the
#                      new version proves healthy.
#
#   ssh-ca-install     Remote-shell (admin-granted support access). Adopt the
#                      cloud's SSH certificate authority: read the CA public
#                      key the engine staged at $state/ssh/ca.pub, validate it
#                      is a single well-formed SSH public key, install it to
#                      /etc/ssh/nexus_ca.pub, ensure the unprivileged
#                      `nexus-remote` login account exists, drop
#                      /etc/ssh/sshd_config.d/60-nexus-ca.conf, `sshd -t`, and
#                      reload sshd. Idempotent — safe to run on every boot.
#
#   ssh-principals-sync
#                      Rewrite the per-session principal allowlist from
#                      $state/ssh/principals (one session UUID per line) to
#                      /etc/ssh/nexus_principals/nexus-remote. Every line is
#                      charset-validated as a UUID before ANY byte is written;
#                      an unparsable file is rejected whole (fail-closed, the
#                      previous allowlist survives). No sshd reload needed —
#                      AuthorizedPrincipalsFile is read per authentication.
#
#   sshd-restart       Validate the sshd config (`sshd -t`) and restart the ssh
#                      unit. Operator recovery path for a wedged sshd, reached
#                      from the cloud console. REFUSES to restart when `sshd
#                      -t` fails, so a bad config can never lock the box out.
#
# NOTE ON ARGUMENTS. sudo's `*` does NOT match `/`, so no mode may accept a
# path argument — that is precisely why the three ssh modes above read their
# input from FIXED, engine-writable staging paths under $state/ssh/ instead of
# taking a filename. Argv stays free of separators and the sudoers grant stays
# a simple, frozen wildcard.
#
# EXIT CODES. `apply`/`reflip` return NON-ZERO on any hard failure (extract,
# missing release dir, symlink flip, or restart) so the engine can report a
# real terminal `failed` and roll back. The apt/journald sub-steps and `prune`
# are best-effort and never fail the apply. `--no-block` on the restart is
# load-bearing (see the byte-for-byte note in
# crates/nexus-engine/src/cloud_update.rs) — the sudo child shares the engine
# cgroup and is SIGTERM'd on unit stop before it can return.
set -euo pipefail

log()  { printf 'nexus-apply-release: %s\n' "$*"; }
warn() { printf 'nexus-apply-release: WARN: %s\n' "$*" >&2; }
die()  { printf 'nexus-apply-release: ERROR: %s\n' "$*" >&2; exit 1; }

mode="${1:-}"
version="${2:-}"

# Fixed on-box layout. NEXUS_PREFIX is overridable ONLY for offline tests (a
# direct, non-sudo invocation); under the real OTA sudo scrubs the environment,
# so production always uses the real /opt/nexus tree.
prefix="${NEXUS_PREFIX:-/opt/nexus}"
releases_dir="$prefix/releases"
current_link="$prefix/current"
staged_tarball="$prefix/staging/update.tar.gz"
apply_deps="/usr/local/sbin/nexus-apply-deps"

# Remote-shell (admin-granted support access) layout. `state_dir` is the
# engine-writable tree the unprivileged `nexus` user stages handoff files in;
# everything under /etc/ssh is root-owned and only ever written by this script.
state_dir="${NEXUS_STATE_DIR:-/var/lib/nexus}"
ssh_stage_dir="$state_dir/ssh"
ssh_ca_stage="$ssh_stage_dir/ca.pub"
ssh_principals_stage="$ssh_stage_dir/principals"
ssh_ca_installed="/etc/ssh/nexus_ca.pub"
ssh_dropin="/etc/ssh/sshd_config.d/60-nexus-ca.conf"
ssh_principals_dir="/etc/ssh/nexus_principals"
# The dedicated, unprivileged login the session certificates map onto. It is
# deliberately NOT in `sudo`: a cloud-brokered session must not silently confer
# root. It gets `nexus` (read engine state), `adm` + `systemd-journal` (read
# logs) so support can actually diagnose. Escalation stays a human decision
# made with a real password at the console.
ssh_account="nexus-remote"
ssh_account_groups="nexus,adm,systemd-journal"

# Strict validation of the release version. sudo's `*` never matches `/`, but
# defence-in-depth: a version is a bounded token of the release-tag charset,
# never a path. This is the load-bearing guard that lets the sudoers grant be a
# simple wildcard.
validate_version() {
    [[ -n "$version" ]] || die "missing <version> for '$mode'"
    [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] \
        || die "invalid version '$version' (charset)"
    [[ "$version" != *".."* ]] || die "invalid version '$version' (path traversal)"
}

release_path=""
resolve_release_path() {
    release_path="$releases_dir/$version"
}

# ---- symlink flip + unit restart (shared by apply + reflip) -----------------
# The two operations that MUST succeed for the version to take effect. Any
# failure here is a hard, non-zero exit so the engine reports a terminal state.
flip_and_restart() {
    if ! ln -sfn "$release_path" "$current_link"; then
        die "failed to flip $current_link -> $release_path"
    fi
    log "flipped $current_link -> $release_path"
    # The restart MUST be issued from outside this unit's cgroup. `systemctl
    # --no-block` still returns before the job runs, but the caller chain
    # (engine -> sudo -> this script) lives in nexus-engine.service, so the
    # stop job SIGTERMs this process a few milliseconds later — usually before
    # it can exit 0, which the engine then reports to the cloud as a failed
    # apply even though the release took effect. `systemd-run` parks the
    # restart in a transient unit of its own; the short sleep lets this script
    # exit 0 and lets the engine record the outcome first.
    # Mirror any change to the engine's expectation in
    # crates/nexus-engine/src/cloud_update.rs.
    if command -v systemctl >/dev/null 2>&1; then
        if command -v systemd-run >/dev/null 2>&1 &&
            systemd-run --collect --quiet --unit="nexus-ota-restart-$$" \
                /bin/sh -c 'sleep 3; exec systemctl restart nexus-engine'; then
            log "restart scheduled for nexus-engine (transient unit)"
        elif systemctl --no-block restart nexus-engine; then
            log "restart enqueued for nexus-engine (--no-block fallback)"
        else
            die "failed to schedule restart of nexus-engine"
        fi
    else
        warn "no systemctl on PATH — skipping restart (test host?)"
    fi
}

# Refresh the pinned appliers from the release that is about to be flipped in.
#
# Both wrappers live outside the OTA-writable /opt/nexus tree and are normally
# only installed by scripts/install.sh. That means a bug fixed in either script
# could NEVER reach an already-installed box over the air — every fix required
# a manual re-run of the installer per site. Refreshing them here closes that
# gap without widening the trust boundary: the engine has already verified the
# tarball's Ed25519 signature before invoking us, and we were about to execute
# that same tree as root anyway.
#
# The copy is an atomic rename, NOT an in-place write: this script is currently
# executing and bash reads it incrementally by file offset, so truncating the
# live inode (what `install`/`cp` do) would corrupt the rest of this run. The
# rename swaps in a new inode and leaves ours intact until exit.
refresh_appliers() {
    local src dst tmp name
    for name in nexus-apply-release nexus-apply-deps; do
        src="$release_path/scripts/$name"
        dst="/usr/local/sbin/$name"
        [[ -r "$src" ]] || continue
        if cmp -s "$src" "$dst" 2>/dev/null; then
            continue
        fi
        tmp="$(mktemp "/usr/local/sbin/.$name.XXXXXX")" || {
            warn "could not stage applier refresh for $name; keeping installed copy"
            continue
        }
        if cat "$src" >"$tmp" \
            && chown root:root "$tmp" \
            && chmod 0755 "$tmp" \
            && mv -f "$tmp" "$dst"; then
            log "refreshed applier from release: $dst"
        else
            rm -f "$tmp"
            warn "applier refresh failed for $name; keeping installed copy"
        fi
    done
}

do_apply() {
    validate_version
    resolve_release_path

    [[ -r "$staged_tarball" ]] || die "staged tarball not found: $staged_tarball"
    install -d -m 0755 "$releases_dir" 2>/dev/null || true

    # Extract the staged tarball. Its single top-level dir is the bare
    # <version>, so (no --strip-components) the tree lands at
    # releases/<version>/.
    if ! tar -xzf "$staged_tarball" -C "$releases_dir"; then
        die "tar extract failed: $staged_tarball -> $releases_dir"
    fi
    [[ -d "$release_path" ]] \
        || die "extracted release dir missing: $release_path (tarball top-level != bare version?)"
    log "extracted release: $release_path"

    # Pick up any applier fix shipped in this release before we use the deps
    # wrapper below or flip the symlink.
    refresh_appliers

    # Privileged, best-effort root-side bits (apt deps + journald cap). We are
    # already root, so call the deps wrapper directly (no sudo). --no-prune:
    # pruning is deferred to the post-health `prune` mode so a failed apply can
    # never delete the rollback target.
    if [[ -x "$apply_deps" ]]; then
        if "$apply_deps" "$release_path" --no-prune; then
            log "applied release privileged config (deps + journald)"
        else
            warn "nexus-apply-deps exited non-zero; proceeding with flip (optional features may degrade)"
        fi
    else
        warn "no $apply_deps on box — skipping deps/journald (optional features may degrade)"
    fi

    flip_and_restart
}

do_reflip() {
    validate_version
    resolve_release_path
    [[ -d "$release_path" ]] || die "rollback target not on disk: $release_path"
    flip_and_restart
}

# ---- prune (post-health; best-effort, never fails the caller) ---------------
# Keep ONLY the `current` target and <version>. Fail-closed (delete nothing) on
# an empty keep set; stay bounded to $releases_dir; only ever operate on a real
# ".../releases" dir. This is a `rm -rf` wrapper, so be conservative.
do_prune() {
    validate_version
    if [[ ! -d "$releases_dir" ]]; then
        log "no releases dir ($releases_dir) — nothing to prune"
        return 0
    fi
    if [[ "$(basename "$releases_dir")" != "releases" ]]; then
        warn "refusing to prune: $releases_dir is not a 'releases' directory"
        return 0
    fi
    declare -A keep=()
    local curv dir name removed=0
    [[ -d "$releases_dir/$version" ]] && keep["$version"]=1
    if [[ -L "$current_link" ]]; then
        curv="$(basename "$(readlink -f "$current_link" 2>/dev/null || true)")"
        [[ -n "$curv" && -d "$releases_dir/$curv" ]] && keep["$curv"]=1
    fi
    if (( ${#keep[@]} == 0 )); then
        warn "empty keep set — refusing to prune releases (fail-closed)"
        return 0
    fi
    log "keeping releases: ${!keep[*]}"
    shopt -s nullglob
    for dir in "$releases_dir"/*/; do
        name="$(basename "$dir")"
        [[ -n "${keep[$name]:-}" ]] && continue
        if rm -rf -- "$dir"; then
            log "pruned old release: $name"
            removed=$(( removed + 1 ))
        else
            warn "failed to prune '$name' (will retry next OTA)"
        fi
    done
    shopt -u nullglob
    log "pruned $removed old release(s)"
    return 0
}

# ---- remote shell: SSH certificate authority adoption ----------------------
# Escape the calling service's mount namespace, if we are in one.
#
# The engine invokes us with `sudo` from inside nexus-engine.service, which
# sets ProtectSystem=full (=> /usr, /boot, /etc read-only) with only
# /var/lib/nexus, /opt/nexus and /tmp writable. That is exactly right for the
# OTA path, which only ever writes /opt. It is fatal for the remote-shell
# modes, whose whole job is writing /etc/ssh: `sudo` changes credentials, not
# mounts, so being root inside that namespace buys nothing and every write
# fails with "Read-only file system" (or, for useradd, the far more
# misleading "cannot lock /etc/passwd; try again later"). See BUG-032.
#
# Re-exec through PID 1 instead. systemd starts a transient unit on the host
# mounts, so the same script runs with a writable /etc. Deliberately done
# HERE and not by widening the unit's ReadWritePaths: install.sh writes the
# unit and an OTA never re-applies it, so a unit-file fix would reach fresh
# installs only and leave every deployed appliance broken. This script ships
# in the release tarball, so it self-heals on the next update.
reexec_on_host_mounts() {
    [[ -n "${NEXUS_APPLY_UNSANDBOXED:-}" ]] && return 0
    [[ -d /etc/ssh ]] || die "/etc/ssh does not exist — is openssh-server installed?"

    # Probe by writing, not by testing permission bits: a read-only MOUNT is
    # invisible to `[[ -w ]]`, which only reads the mode and always says yes
    # for root.
    local probe="/etc/ssh/.nexus-apply-probe.$$"
    if (: > "$probe") 2>/dev/null; then
        rm -f "$probe"
        return 0
    fi

    command -v systemd-run >/dev/null 2>&1 \
        || die "/etc is read-only for this process and systemd-run is unavailable"

    log "/etc is read-only in this mount namespace; re-running on the host mounts"
    exec systemd-run --quiet --pipe --wait --collect \
        --unit="nexus-apply-ssh-$mode-$$" \
        --setenv=NEXUS_APPLY_UNSANDBOXED=1 \
        "$0" "$mode"
}

# Which unit carries sshd on this box. Debian/Ubuntu ship `ssh.service`;
# RHEL-likes ship `sshd.service`. Resolve once, prefer whichever is enabled.
sshd_unit() {
    local u
    for u in ssh sshd; do
        if systemctl list-unit-files "$u.service" >/dev/null 2>&1 \
            && systemctl cat "$u.service" >/dev/null 2>&1; then
            printf '%s' "$u"
            return 0
        fi
    done
    return 1
}

# `sshd -t` — parse+validate the FULL effective config. Load-bearing: every
# mode that touches sshd config runs this BEFORE reloading, so a malformed
# drop-in can never lock the operator out of their own appliance.
sshd_validate() {
    local sshd_bin
    sshd_bin="$(command -v sshd || true)"
    [[ -x "$sshd_bin" ]] || sshd_bin=/usr/sbin/sshd
    if [[ ! -x "$sshd_bin" ]]; then
        warn "no sshd binary found — skipping config validation (test host?)"
        return 0
    fi
    "$sshd_bin" -t
}

sshd_reload() {
    local unit
    if ! command -v systemctl >/dev/null 2>&1; then
        warn "no systemctl on PATH — skipping sshd reload (test host?)"
        return 0
    fi
    unit="$(sshd_unit)" || { warn "no ssh/sshd unit on this box — skipping reload"; return 0; }
    if ! systemctl reload "$unit"; then
        warn "systemctl reload $unit failed; trying restart"
        systemctl restart "$unit" || die "could not reload or restart $unit"
    fi
    log "reloaded $unit"
}

# Ensure the dedicated, unprivileged login the session certificates map onto.
# Idempotent. Deliberately NOT added to `sudo` — see $ssh_account_groups above.
ensure_ssh_account() {
    local g
    if id -u "$ssh_account" >/dev/null 2>&1; then
        log "login '$ssh_account' already present"
    else
        useradd --create-home --shell /bin/bash \
                --comment "Nexus admin-granted remote support access" \
                "$ssh_account" \
            || die "failed to create login '$ssh_account'"
        log "created login '$ssh_account'"
    fi
    # Never a usable password: certificate auth only.
    passwd --lock "$ssh_account" >/dev/null 2>&1 || true
    # Best-effort supplementary groups — a missing group on a given box must
    # not fail CA adoption.
    IFS=',' read -r -a _groups <<< "$ssh_account_groups"
    for g in "${_groups[@]}"; do
        getent group "$g" >/dev/null 2>&1 || continue
        usermod -aG "$g" "$ssh_account" >/dev/null 2>&1 \
            || warn "could not add '$ssh_account' to group '$g'"
    done
    # Explicit: the loop's exit status is its last iteration's, and under
    # `set -e` a failing group add would otherwise abort CA adoption — the
    # opposite of the best-effort this block claims to be (BUG-032).
    return 0
}

do_ssh_ca_install() {
    [[ -r "$ssh_ca_stage" ]] || die "no staged CA public key at $ssh_ca_stage"
    # Exactly one line, and `ssh-keygen -l` must accept it as a public key.
    # This is the whole trust decision, so validate before installing.
    local lines
    lines="$(grep -cve '^[[:space:]]*$' "$ssh_ca_stage" || true)"
    [[ "$lines" == "1" ]] \
        || die "staged CA key must be exactly one key line (got $lines)"
    if command -v ssh-keygen >/dev/null 2>&1; then
        ssh-keygen -l -f "$ssh_ca_stage" >/dev/null 2>&1 \
            || die "staged CA key at $ssh_ca_stage is not a valid SSH public key"
    else
        warn "no ssh-keygen on PATH — installing CA key without validation (test host?)"
    fi

    ensure_ssh_account

    install -o root -g root -m 0644 "$ssh_ca_stage" "$ssh_ca_installed" \
        || die "failed to install CA key to $ssh_ca_installed"
    log "installed CA key -> $ssh_ca_installed"

    install -d -o root -g root -m 0755 "$ssh_principals_dir"
    # Always TRUNCATE the principal allowlist on CA adoption. This mode runs at
    # engine start, and at engine start no session is live by definition. A
    # hard kill (SIGKILL, power loss) can otherwise leave a stale principal on
    # disk that would still authorise a certificate the operator believes was
    # revoked. Truncating here makes engine start the backstop.
    install -o root -g root -m 0644 /dev/null "$ssh_principals_dir/$ssh_account"

    install -d -o root -g root -m 0755 /etc/ssh/sshd_config.d
    # Global directives only — NO `Match` block. A Match block in a drop-in
    # terminates the global section for every line sshd reads afterwards
    # (including the rest of the main sshd_config, which is Included from the
    # top on Debian/Ubuntu), which would silently reconfigure unrelated logins.
    # Per-session restrictions belong in the certificate itself, minted with
    # `-O clear -O permit-pty`, which is where the cloud CA puts them.
    cat > "$ssh_dropin" <<EOF
# Managed by nexus-apply-release (ssh-ca-install) — do not edit by hand.
# Admin-granted remote support access. Both directives are inert until the
# cloud issues a session certificate AND the session's principal is present in
# $ssh_principals_dir/$ssh_account.
TrustedUserCAKeys $ssh_ca_installed
AuthorizedPrincipalsFile $ssh_principals_dir/%u
EOF
    chmod 0644 "$ssh_dropin"
    chown root:root "$ssh_dropin"
    log "wrote $ssh_dropin"

    if ! sshd_validate; then
        rm -f "$ssh_dropin"
        die "sshd -t rejected the config; removed $ssh_dropin and left sshd untouched"
    fi
    sshd_reload
}

do_ssh_principals_sync() {
    [[ -d "$ssh_principals_dir" ]] \
        || die "CA not adopted yet (no $ssh_principals_dir) — run ssh-ca-install first"
    local target="$ssh_principals_dir/$ssh_account"
    local tmp="$target.tmp.$$"

    # An absent staging file means "no live sessions" — revoke everything.
    if [[ ! -e "$ssh_principals_stage" ]]; then
        : > "$tmp"
    else
        # Validate EVERY line before writing ANY byte. One bad line rejects the
        # whole file and leaves the previous allowlist in place (fail-closed).
        local line n=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "${line//[[:space:]]/}" ]] && continue
            [[ "$line" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
                || die "refusing principals sync: line $((n + 1)) is not a session UUID"
            n=$(( n + 1 ))
            (( n <= 64 )) || die "refusing principals sync: more than 64 live sessions"
        done < "$ssh_principals_stage"
        grep -Eve '^[[:space:]]*$' "$ssh_principals_stage" > "$tmp" || : > "$tmp"
    fi

    chown root:root "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$target" || { rm -f "$tmp"; die "failed to install $target"; }
    log "synced $(grep -cve '^[[:space:]]*$' "$target" || true) live session principal(s)"
}

do_sshd_restart() {
    sshd_validate || die "sshd -t failed — refusing to restart (config is broken)"
    if ! command -v systemctl >/dev/null 2>&1; then
        warn "no systemctl on PATH — skipping sshd restart (test host?)"
        return 0
    fi
    local unit
    unit="$(sshd_unit)" || die "no ssh/sshd unit on this box"
    systemctl restart "$unit" || die "systemctl restart $unit failed"
    log "restarted $unit"
}

case "$mode" in
    apply)  do_apply ;;
    reflip) do_reflip ;;
    prune)  do_prune ;;
    ssh-ca-install)      reexec_on_host_mounts; do_ssh_ca_install ;;
    ssh-principals-sync) reexec_on_host_mounts; do_ssh_principals_sync ;;
    sshd-restart)        reexec_on_host_mounts; do_sshd_restart ;;
    *)      die "usage: nexus-apply-release {apply|reflip|prune} <version> | {ssh-ca-install|ssh-principals-sync|sshd-restart} (got mode='${mode}')" ;;
esac

exit 0
