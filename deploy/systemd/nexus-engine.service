# Nexus Edge AI engine — bare-metal systemd unit.
#
# Source of truth checked into the repo at deploy/systemd/nexus-engine.service.
# Shipped as part of the release tarball at etc-templates/systemd/nexus-engine.service
# (M-Install Checkpoint 3a.2) and installed by scripts/install.sh to
# /etc/systemd/system/nexus-engine.service on the host.
#
# Layout assumptions (see scripts/install.sh):
#   /opt/nexus/releases/vX.Y.Z/                — extracted tarball, immutable
#   /opt/nexus/current   -> releases/vX.Y.Z    — atomic-swap symlink (rollback = flip)
#   /etc/nexus/nexus.toml                      — operator-editable config (survives upgrades)
#   /var/lib/nexus/                            — runtime state (db, clips, models override)
#
# Upgrade = install.sh extracts new release, flips `current`, runs
#           `systemctl restart nexus-engine`. Rollback = flip the symlink
#           back and restart. The unit file itself never has to change.

[Unit]
Description=Nexus Edge AI engine
Documentation=https://github.com/Keystone-Infrastructure-Corp/nexus-edge-ai-core-next/blob/main/docs/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
# video + render: accelerator device access (/dev/dri, /dev/accel, /dev/hailo).
# systemd-journal: read access to the system journal so the engine can bundle
#   its own recent logs (`journalctl -u nexus-engine`) into the diagnostics
#   tarball for stream-drop / pipeline troubleshooting. Read-only, and NOT a
#   sudoers/privilege change — `SupplementaryGroups=` adds the GID to the
#   service process directly (the group is created by the systemd package on
#   every host, so it always resolves). See `admin_runtime::collect_journal_log`.
#   NOTE: this directive only reaches a box on a fresh install.sh run — the unit
#   file is never re-applied over an OTA. An upgraded box instead gets the
#   `nexus`-user `systemd-journal` membership self-healed on every OTA by
#   `deploy/nexus-apply-deps` (apply_service_groups), which systemd's initgroups
#   picks up on the restart the applier runs next.
SupplementaryGroups=video render systemd-journal
WorkingDirectory=/var/lib/nexus

# ORT shared libs ship inside the release at lib/onnxruntime/. The ort
# crate dlopens libonnxruntime.so (unversioned soname); LD_LIBRARY_PATH
# is required so the OpenVINO provider + intel CPU/GPU/NPU plugins +
# TBB libs that sit alongside it also resolve.
Environment=ORT_DYLIB_PATH=/opt/nexus/current/lib/onnxruntime/libonnxruntime.so
Environment=LD_LIBRARY_PATH=/opt/nexus/current/lib/onnxruntime
Environment=RUST_LOG=info,nexus=info

# XDG_RUNTIME_DIR for the AMD legacy `vaapipostproc` GPU post-proc element.
# On AMD (Mesa radeonsi) the decode chain uses `vaapih26Xdec ! vaapipostproc`
# for GPU colour-convert/scale, because the new `va` plugin's `vapostproc`
# renders all-green on radeonsi (verified on a Radeon 680M / gfx1035, Mesa
# 25.2). `vaapipostproc` runs a GBM/GL probe at caps negotiation that requires
# XDG_RUNTIME_DIR to point at an existing, writable, 0700 dir; without it the
# element errors ("XDG_RUNTIME_DIR is invalid or not set") and the camera
# silently falls back to the CPU-convert chain. As a system service the
# `nexus` user has no login session (no /run/user/<uid>), so let systemd make
# a private one: RuntimeDirectory=nexus creates /run/nexus (0700, owned by
# nexus, torn down on stop). Harmless on Intel / NVIDIA — just an unused env
# var and an empty runtime dir.
RuntimeDirectory=nexus
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/nexus

# AMD ROCm / Radeon GPU configuration.
#
# ROCm is enabled only for AMD GPUs it OFFICIALLY supports — discrete
# RDNA/CDNA parts (gfx1030+) — which the installer classifies at install
# time from the PCI device ID. AMD GPUs ROCm does NOT support (Phoenix /
# Rembrandt iGPUs such as the Radeon 680M/780M, gfx1035/gfx1103) run
# inference through the Vulkan(WebGPU) EP instead; the installer writes a
# 10-ort-webgpu.conf drop-in for them and never force-fits ROCm.
#
# HSA_OVERRIDE_GFX_VERSION is therefore NOT set by default. It exists only
# as an UNSUPPORTED manual escape hatch: an operator who insists on running
# ROCm on an unsupported iGPU may uncomment the line below (10.3.0 maps a
# gfx1035 Phoenix part onto the gfx1030 ISA). This is fragile on older
# kernels and unsupported upstream — prefer the Vulkan path.
# Environment=HSA_OVERRIDE_GFX_VERSION=10.3.0

# NVIDIA (CUDA + TensorRT) operators uncomment the CUDA path. The installed
# binary is built with --features ep-cuda,ep-tensorrt — the EP is only
# activated when ep_priority in nexus.toml asks for it AND libcuda is
# loadable, so leaving this commented on non-NVIDIA boxes is harmless.
# Environment=LD_LIBRARY_PATH=/opt/nexus/current/lib/onnxruntime:/usr/local/cuda/lib64

ExecStart=/opt/nexus/current/bin/nexus-engine --config /etc/nexus/nexus.toml

# Graceful drain (M-OTA Step 1). Engine traps SIGTERM, EOSes every
# open mp4mux so clips finish writing instead of stranding at a
# header-only 864-byte stub on restart, then drains the cloud outbox
# before exiting 0. TimeoutStopSec caps the drain; on expiry systemd
# escalates to SIGKILL.
TimeoutStopSec=30s
KillSignal=SIGTERM

Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

# Capabilities granted to the (non-root) `nexus` user:
#
#   * CAP_NET_BIND_SERVICE — bind the UI listeners on :80 and
#     :443. api_bind defaults to :8089 and does not need this;
#     ui_bind = "0.0.0.0:80" and https_bind = "0.0.0.0:443"
#     (both defaults in every tier config since v0.1.34) do.
#
#   * CAP_PERFMON — open the `i915` PMU via `perf_event_open(2)`
#     so the system metrics endpoint can return real Intel iGPU
#     utilization. The engine opens 4-6 fds at boot (one per
#     `<engine>-busy` event), reads each on demand. Without
#     this cap the open returns EACCES and the engine silently
#     falls back to reporting no utilization (Linux 5.8+ moved
#     PMU access from CAP_SYS_ADMIN to CAP_PERFMON; on older
#     kernels we'd need CAP_SYS_ADMIN, but every tier ships
#     Ubuntu 24.04 + HWE >= 6.8).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_PERFMON
# CapabilityBoundingSet is a capability CEILING, not a grant. It MUST include
# the caps the setuid-root `sudo` binary needs to initialize for the Phase 9
# (M_OTA) apply path (the three pinned /etc/sudoers.d/nexus-update commands:
# tar extract, symlink flip, self restart). With only {NET_BIND,PERFMON} in
# the bounding set, sudo cannot acquire CAP_SETUID/CAP_SETGID/CAP_AUDIT_WRITE
# and fails at "error initializing audit plugin sudoers_audit", so every OTA
# apply aborts with code=artifact_unavailable. This is the sibling gotcha to
# NoNewPrivileges below — both silently break the setuid `sudo` transition.
# The engine's OWN effective caps stay minimal (AmbientCapabilities above is
# still just NET_BIND + PERFMON); the extra caps here are only ever reachable
# through the setuid transition into `sudo`, never held by the engine itself.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_PERFMON CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_AUDIT_WRITE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_FSETID

# Hardening — keep the engine boxed in.
#
# NoNewPrivileges is deliberately NOT set: the Phase 9 (M_OTA) update
# path shells out to `sudo` for the three pinned commands in
# /etc/sudoers.d/nexus-update (tar extract, symlink flip, self
# restart). NoNewPrivileges=true sets PR_SET_NO_NEW_PRIVS on the
# engine, which makes the setuid `sudo` binary unable to escalate —
# the OTA apply would fail closed. The sudoers allowlist is the
# privilege boundary instead: a compromised engine can run ONLY those
# three exact command lines as root, nothing else.
NoNewPrivileges=false
# ProtectSystem=full (not strict): /usr, /boot, /etc stay read-only,
# but /opt is writable so the OTA can extract into
# /opt/nexus/releases/<version>/ and flip /opt/nexus/current. The
# bytes written there were already signature- + sha256-verified
# in-process before the privileged tar runs.
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/nexus /opt/nexus /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
DevicePolicy=closed

# Allow accelerator devices per tier. No-op when the device doesn't
# exist on this host; leave them all in so the unit is portable.
# DRM uses the device-class form (char-drm = major 226, all card*/renderD*).
# The path form `DeviceAllow=/dev/dri rw` is a no-op because /dev/dri is a
# directory, not a device node — without this the OpenVINO GPU plugin sees
# "Device GPU is not available" and silently falls back to CPU.
DeviceAllow=char-drm rw
DeviceAllow=/dev/accel/accel0 rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
# Hailo-8 M.2. The hailo_pci driver registers a private char
# major (511 on Ubuntu 24.04 HWE), so neither char-drm nor /dev/accel/*
# covers it; without this line DevicePolicy=closed denies the open
# even though world perms are crw-rw-rw-.
DeviceAllow=/dev/hailo0 rw
# AMD ROCm compute (Radeon iGPU/dGPU). /dev/kfd is the KFD (Kernel
# Fusion Driver) character device used by HIP + ROCm libraries for
# GPU compute. Gated to the 'render' group by default (mode 0660).
# The install.sh script adds the `nexus` user to 'render', so the
# engine can open it.
DeviceAllow=/dev/kfd rw

[Install]
WantedBy=multi-user.target
